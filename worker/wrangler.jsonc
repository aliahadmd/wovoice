{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wovoice-transcription",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wovoice.aliahad.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/.well-known/*", "/app/callback*", "/login*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wovoice-accounts-production",
      "database_id": "21c1a2d4-9ca5-43bb-858e-3ecb69534de2",
      "migrations_dir": "./migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@wovoice.aliahad.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026080501",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026080503",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "ASR_MODEL": "whisper",
    "APP_ORIGIN": "https://wovoice.aliahad.com",
    "ENVIRONMENT": "production",
    "SUPPORT_EMAIL": "support@aliahad.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEGXORiDrI06ZVTr",
    "LEGACY_AUTH_DEADLINE": "2026-08-11T19:00:00.000Z"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["AUTH_MASTER_KEY", "PII_KEY", "TURNSTILE_SECRET"]
  }
}
