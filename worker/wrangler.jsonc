{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wovoice-transcription",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026080501",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "ASR_MODEL": "whisper"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["CLIENT_TOKEN"]
  },
  "env": {
    "staging": {
      "name": "wovoice-transcription-staging",
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2026080502",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "vars": {
        "ASR_MODEL": "whisper"
      },
      "secrets": {
        "required": ["CLIENT_TOKEN"]
      }
    }
  }
}
